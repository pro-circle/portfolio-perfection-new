# Copy to .env and fill in real values. All VITE_* vars are inlined into the
# client bundle at build time — never put a service-role key here.

# EmailJS (contact form) — https://dashboard.emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Supabase (visitor analytics) — Project Settings -> API
# Use the anon / publishable key ONLY.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
